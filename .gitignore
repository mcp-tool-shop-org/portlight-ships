# Meshes are BUILD INPUTS, not repo content.
# One galleon GLB is ~58 MB; a full hull line is 400 MB+. They live in the mesh
# store and are re-derivable from the saved Comfy workflow. Sprites are what
# this repo ships.
*.glb
*.gltf
*.fbx
*.obj
mesh/
mesh-store/

# Local staging + intermediates
# NOTE: plates-raw/ is deliberately NOT ignored — the plates are the expensive
# artifact (a paid generation each) and are small enough to version. Only the
# derived, re-runnable outputs are excluded.
_staging/
turntable/
plates-rgba/
plates-normalised/
__pycache__/
*.pyc

# OS
Thumbs.db
.DS_Store

# showcase panels live in the public brand repo, not here
_showcase/
